# DEVAMRUTAM Environment Variables Example
# Duplicate this file to .env.local for local development.
# Do NOT commit production secrets to Git.

# --- Public Site Configuration ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase Configuration (Optional for initial launch) ---
# The website runs fully in preview/memory-logging mode if these are omitted.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Transactional Email (Resend) ---
# The website runs gracefully if omitted; emails are simply logged.
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=admin@devamrutam.com
CONTACT_EMAIL=contact@devamrutam.com

# --- Configurable Social Links (Optional Overrides) ---
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/91XXXXXXXXXX
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/devamrutam
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@devamrutam
